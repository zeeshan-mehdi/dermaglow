    <h1>Page not found</h1>
    <p>That article doesn't exist — it may have been moved or renamed.</p>
  </div>
  <div class="wrap" style="text-align:center; padding-bottom:80px;">
    <a class="badge" href="/">Browse all articles</a>
  </div>
</BaseLayout>
